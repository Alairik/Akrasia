# Akrasia – Apache URL Rewriting pro ZveleCMS

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"
    Header always set Permissions-Policy      "geolocation=(), microphone=(), camera=()"
    Header always set X-XSS-Protection        "1; mode=block"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # HTTPS vynucení
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Ochrana interních složek
    RewriteRule ^includes(/.*)?$  - [F,L]
    RewriteRule ^pages(/.*)?$     - [F,L]
    RewriteRule ^core(/.*)?$      - [F,L]

    # Průchodné složky (nerewritovat)
    RewriteRule ^admin(/.*)?$     - [L]
    RewriteRule ^assets(/.*)?$    - [L]
    RewriteRule ^uploads(/.*)?$   - [L]
    RewriteRule ^api(/.*)?$       - [L]
    RewriteRule ^themes(/.*)?$    - [L]

    # Statické soubory
    RewriteRule ^sitemap\.xml$    - [L]
    RewriteRule ^robots\.txt$     - [L]
    RewriteRule ^favicon\.ico$    - [L]
    RewriteRule ^install\.php$    - [L]
    RewriteRule ^seed\.php$       - [L]

    # Existující soubory a složky nechej projít
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Vše ostatní jde do ZveleCMS routeru
    RewriteRule ^ index.php [L,QSA]

</IfModule>
