# Akrasia – Apache URL Rewriting pro ZveleCMS
# Nasazeno do /www/akrasia/.htaccess
#
# POZNÁMKA: HTTPS vynucení a subdomain routing řeší root /www/.htaccess
# (_server/.htaccess). Zde stačí jen Akrasia-specifická pravidla.
# RewriteBase /akrasia/ je nutné – WEDOS alias přepíše URI na /akrasia/path.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"
    Header always set Permissions-Policy      "geolocation=(), microphone=(), camera=()"
    Header always set X-XSS-Protection        "1; mode=block"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /akrasia/

    # Ochrana interních složek (přímý přístup zakázán)
    RewriteRule ^includes(/.*)?$  - [F,L]
    RewriteRule ^pages(/.*)?$     - [F,L]
    RewriteRule ^core(/.*)?$      - [F,L]
    RewriteRule ^protected(/.*)?$ - [F,L]

    # Průchodné složky (nerewritovat, Apache obslouží přímo)
    RewriteRule ^admin(/.*)?$     - [L]
    RewriteRule ^assets(/.*)?$    - [L]
    RewriteRule ^uploads(/.*)?$   - [L]
    RewriteRule ^api(/.*)?$       - [L]
    RewriteRule ^themes(/.*)?$    - [L]

    # Statické soubory
    RewriteRule ^sitemap\.xml$        - [L]
    RewriteRule ^robots\.txt$         - [L]
    RewriteRule ^favicon\.ico$        - [L]
    RewriteRule ^install\.php$        - [L]
    RewriteRule ^seed\.php$           - [L]
    RewriteRule ^member-migrate\.php$ - [L]

    # Existující soubory a složky nechej projít
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Vše ostatní jde do ZveleCMS routeru
    RewriteRule ^ index.php [L,QSA]

</IfModule>
