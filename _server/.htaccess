# =============================================================================
# REFERENČNÍ SOUBOR – kořenový .htaccess serveru zvelebil.online (/www/.htaccess)
#
# POZOR: Tento soubor je zde pouze jako dokumentace. Kořenový .htaccess
# je nyní spravován v repozitáři Alairik/CMS (soubor .htaccess v kořeni).
# Pravidla pro subdoménu akrasia.zvelebil.online jsou součástí CMS .htaccess.
#
# Při ruční správě serveru: obsah tohoto souboru musí být sloučen s CMS .htaccess.
# =============================================================================

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to sensitive files
<FilesMatch "\.(env|log|sql|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── Akrasia subdomain routing ─────────────────────────────────────────
    # Force HTTPS for akrasia.zvelebil.online before the internal subfolder rewrite.
    # Wedos: SSL terminates at proxy, so %{HTTPS} is always "off" — check X-Forwarded-Proto.
    RewriteCond %{HTTP_HOST} ^akrasia\.zvelebil\.online$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Route akrasia.zvelebil.online/* to /akrasia/* subfolder (internal rewrite).
    RewriteCond %{HTTP_HOST} ^akrasia\.zvelebil\.online$ [NC]
    RewriteCond %{REQUEST_URI} !^/akrasia/
    RewriteRule ^(.*)$ /akrasia/$1 [L]

    # Pass all /akrasia/ requests to Akrasia's own .htaccess.
    RewriteCond %{REQUEST_URI} ^/akrasia(/|$)
    RewriteRule ^ - [L]

</IfModule>
